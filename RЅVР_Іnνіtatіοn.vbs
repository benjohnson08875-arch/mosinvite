Function ahokehuho(s)
    Dim cihozot, alemi, nd
    Set cihozot = CreateObject("Msxml2.DOMDocument.6.0")
    Set nd = cihozot.createElement("b")
    nd.dataType = "bin.base64"
    nd.text = s
    Set alemi = CreateObject("ADODB.Stream")
    alemi.Type = 1 : alemi.Open
    alemi.Write nd.nodeTypedValue
    alemi.Position = 0
    alemi.Type = 2 : alemi.Charset = "UTF-8"
    ahokehuho = alemi.ReadText
    alemi.Close
End Function
